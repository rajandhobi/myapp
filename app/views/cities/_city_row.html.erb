<turbo-frame id="city_<%= city.id %>">
  <div class="row mb-4">
    <div class="col-md-10"> 
      <table class="table table-sm table-bordered shadow-sm">
        <thead class="table-light">
          <tr>
            <th>City Name</th>
            <th>Country</th>
            <th>Media</th>
            <th width="100">Actions</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>
              <h5 class="mb-1"><%= short_name(city) %></h5>
              <small><%= created_ago(city) %></small>
            </td>
            <td class="align-middle"><%= city.country %></td>
            <td class="text-center">
              <%= image_tag "ahmedabad.gif", width: 100, class: "rounded border" %>
            </td>
            <td class="align-middle">
              <div class="d-flex flex-column gap-1">
                <%= link_to "Show", city_path(city), class: "btn btn-xs btn-outline-secondary" %>
                <%= link_to "Edit", edit_city_path(city), class: "btn btn-xs btn-outline-primary" %>
                <%= button_to "Delete", city_path(city), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn btn-xs btn-outline-danger" %>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</turbo-frame>