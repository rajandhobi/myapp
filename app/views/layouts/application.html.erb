<!DOCTYPE html>
<html>
  <head>
    <title>
      <%= content_for?(:html_title) ? yield(:html_title) : "Default Title" %>
    </title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

  <meta name="view-transition" content="same-origin"/>
  <%# <meta name = "turbo-root" content= "/cities"> %>
  <%# <meta name="turbo-visit-control" content="reload"> %>
<meta name="data-turbo-preload" content="true">
  <meta name="application-name" content="Myapp">
  <meta name="mobile-web-app-capable" content="yes">
  
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= turbo_include_tags %>
    

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js">
      </script>
  </head>

  <body>
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Flash Messages -->
    <div id="flash-messages" style="position: fixed; top: 20px; right: 20px; z-index: 1000;">
      <% flash.each do |type, message| %>
        <div class="toast-card <%= type %>">
          <%= message %>
        </div>
      <% end %>
    </div>

    <!-- Main content -->
    <div id="content">
      <% if user_signed_in? %>
        <%= button_to "Logout", destroy_user_session_path, method: :delete %>
      <% end %>
      <%= content_for?(:content) ? yield(:content) : yield %>
    </div>

    <!-- Extra flash messages (optional) -->
    <% flash.each do |type, msg| %>
      <div class="<%= type %>"><%= msg %></div>
    <% end %>
  </body>
</html>
