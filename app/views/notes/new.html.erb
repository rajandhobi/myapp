<h1>Notes#new</h1>
<p>Find me in app/views/notes/new.html.erb</p>
<!-- app/views/notes/new.html.erb -->

<h1>New Note</h1>

<%= form_with model: @notes do |f| %>
  <p>
    <%= f.label :title %> <br>  
    <%= f.text_field :title %>
  </p>

  <p>
    <%= f.label :content %><br>
    <%= f.text_area :content %>
  </p>  

  <%= f.submit "Create Note" %>
<% end %>
